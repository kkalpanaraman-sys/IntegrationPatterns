# Kafka connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=order-integration
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMERS=10

# Downstream REST endpoint
# Local demo endpoint (the mock controller in this Spring Boot application)
DOWNSTREAM_ENDPOINT_URL=http://localhost:8080/mock/downstream/orders
# Keep false for the included local mock. Set true for a real OAuth2-protected API.
DOWNSTREAM_AUTH_ENABLED=false

# OAuth 2.0 Client Credentials flow (required when DOWNSTREAM_AUTH_ENABLED=true)
# Obtain these values from the API/provider identity administrator. Never commit real secrets.
OAUTH2_TOKEN_URI=https://identity.example.com/oauth2/token
OAUTH2_CLIENT_ID=replace-me
OAUTH2_CLIENT_SECRET=replace-me
# Optional; use the exact scope(s) required by your provider, separated by spaces.
OAUTH2_SCOPE=orders.write
# Use client_secret_post only if the identity provider requires it.
OAUTH2_CLIENT_AUTH_METHOD=client_secret_basic

# Throughput and retry tuning
# Start low and tune to the downstream provider's actual limits.
DOWNSTREAM_MAX_CONCURRENCY=10
DOWNSTREAM_QUEUE_SIZE=2000
RETRY_MAX_REDELIVERIES=3
RETRY_DELAY_MS=1000
